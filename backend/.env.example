# PostgreSQL
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Database (used by Medusa container)
DATABASE_URL=postgres://medusa:change_me_to_a_strong_password@postgres:5432/medusa

# Redis
REDIS_URL=redis://redis:6379

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret
COOKIE_SECRET=change_me_cookie_secret

# CORS
STORE_CORS=https://paredes.tn,https://www.paredes.tn
ADMIN_CORS=https://admin.paredes.tn
AUTH_CORS=https://admin.paredes.tn,https://paredes.tn,https://www.paredes.tn

# Medusa
MEDUSA_ADMIN_ONBOARDING_TYPE=default
